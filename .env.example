# ───────── QUEEN AKUMA  •  BY INCONNU BOY SENSEI ─────────
# Rename this file to  .env  and fill it in.

# Option 1: paste your session  ->  INCONNU-BOY-SENSEI~..., Dex-Bot-md~... or QUEEN-AKUMA~... (base64 or mega id)
SESSION_ID=""

# Option 2: leave SESSION_ID empty and put your number (with country code, no +)
# the bot will print a pairing code in the console.
PAIRING_NUMBER="554488138425"

PORT="5000"
TIMEZONE="Asia/Kolkata"

# Follow the INCONNU BOY SENSEI channel automatically on connect (true/false)
AUTO_FOLLOW_CHANNEL="true"

# RAM limit (MB) before auto-restart
MAX_RAM_MB="700"

# Optional keys
REMOVEBG_KEY=""
GIPHY_KEY=""
LOLHUMAN_KEY=""
NEOXR_KEY=""
ZENZ_KEY=""

# Optional: override the third-party API host used by .play / .terabox
# DEMON_API_BASE=""

# Optional database (default: local SQLite file). Use ONE of these:
# MONGO_URL="mongodb://localhost:27017/whatsapp"
# POSTGRES_URL="postgresql://user:pass@localhost/whatsapp"
# MYSQL_URL="mysql://user:pass@localhost/whatsapp"
# DB_URL="./baileys_store.db"


# EliteProTech API — https://eliteprotech-apis.zone.id/dashboard
ELITE_API_BASE="https://eliteprotech-apis.zone.id"
ELITE_API_KEY=""

# Telegram bot (optional) — token @BotFather se (/newbot), Owner ID @userinfobot se
# Ya settings.js me telegramBotToken / telegramOwnerId bhar do (v2.8.10).
TELEGRAM_BOT_TOKEN=""
TELEGRAM_OWNER_ID=""

# GitHub session backup (v2.9.2, Mishu system) — OPTIONAL
# PRIVATE repo banao (jaise ton-user/QUEEN-AKUMA-SESSIONS), token ko GitHub par
# `repo` scope do. Token kabhi share mat karo, kabhi file me mat likho.
# Repo PUBLIC hua to tumhara WhatsApp account khatre me pad jayega!
GITHUB_TOKEN=""
GITHUB_REPO=""
GITHUB_BRANCH="main"

# --- v3.0.0 Voice Mode (STT, free keys) ---
# Groq Whisper (best): console.groq.com se free key
# GROQ_API_KEY=gsk_...
# Wit.ai fallback (free): wit.ai -> Server Access Token
# WIT_AI_TOKEN=...

# ───── Multi-session (manager.js) ─────
# Mot de passe du panel web (http://<host>:PORT/). Sans lui, un mot de passe
# temporaire est affiché au démarrage.
ADMIN_PASSWORD=
# Nombre max de bots (0 = illimité)
MAX_BOTS=0
# true = page publique /pair où n'importe qui peut créer SON bot avec son numéro
PUBLIC_PAIRING=false
# Limite RAM par bot (Mo) — le bot se relance seul au-delà
BOT_MAX_RAM_MB=400
# Ports internes des bots (un par bot, non exposés)
BOT_PORT_BASE=6100
# NB : SESSION_ID, MONGO_URL, POSTGRES_URL, TELEGRAM_BOT_TOKEN, GITHUB_TOKEN,
# OWNER_NUMBER, BOT_NAME... ne sont PAS partagés entre bots. Les mettre dans
# instances/<numéro>/.env ou dans le champ "env" du bot dans bots.json.
