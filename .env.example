# SYRIX VCF — copy to .env (scripts/install.sh does it for you and generates every secret).
# Never commit .env. Never reuse these example values.

# public address
DOMAIN=vcf.example.com                      # DNS A/AAAA record must point to this server for automatic HTTPS
APP_URL=https://vcf.example.com
ACME_EMAIL=syrixcompany@gmail.com           # Let's Encrypt account e-mail (expiry notices)

# administrator: matched against the verified Google identity at sign-in, never against user input
ADMIN_EMAIL=syrixcompany@gmail.com
SUPPORT_EMAIL=syrixcompany@gmail.com

# runtime
NODE_ENV=production
LOG_LEVEL=info                              # debug | info | warn | error
WORKER_CONCURRENCY=4
SYNC_RATE_PER_SECOND=5                      # Google People API writes per second, per worker

# data stores (compose builds DATABASE_URL and REDIS_URL from these; both stay on the private network)
POSTGRES_PASSWORD=generate-with-openssl-rand-hex-24
REDIS_PASSWORD=generate-with-openssl-rand-hex-24

# secrets: openssl rand -hex 32
SESSION_SECRET=generate-with-openssl-rand-hex-32
ENCRYPTION_KEY=generate-with-openssl-rand-hex-32       # AES-256-GCM key for OAuth tokens, payout details, backups
ENCRYPTION_KEY_VERSION=1
# ENCRYPTION_KEYS_PREVIOUS=                            # after a key rotation: "1:<old hex key>" so old data stays readable

# Google OAuth 2.0 (see docs/GOOGLE_SETUP.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://vcf.example.com/api/auth/google/callback

# transactional e-mail (optional; without it e-mails are only logged)
EMAIL_PROVIDER=none                         # none | resend
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=SYRIX VCF <no-reply@vcf.example.com>

# alerts (optional): JSON POST for failed backups, stuck queues, full disk
ALERT_WEBHOOK_URL=

# ads (off by default; public pages only, after consent)
ADS_ENABLED=false
ADS_CLIENT_ID=

# backups (scripts/backup.sh)
BACKUP_DIR=/var/backups/syrix-vcf
BACKUP_KEEP_DAYS=14
BACKUP_PASSPHRASE=generate-with-openssl-rand-hex-32  # encrypts backup files; keep a copy OFF this server
# RCLONE_REMOTE=offsite:syrix-vcf-backups          # optional off-site copy (rclone remote configured on the host)
