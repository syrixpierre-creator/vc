# SYRIX VCF — copy to .env and fill in. Never commit .env. Never reuse these example values.

# runtime
NODE_ENV=production
APP_URL=https://vcf.example.com            # public https URL of the site (placeholder domain)
LOG_LEVEL=info                             # debug | info | warn | error

# data stores (private network only; the compose file does not publish these ports)
POSTGRES_PASSWORD=change-me-generate-with-openssl-rand
DATABASE_URL=postgres://syrix:change-me-generate-with-openssl-rand@postgres:5432/syrix
REDIS_URL=redis://redis:6379

# secrets: generate with `openssl rand -hex 32`
SESSION_SECRET=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-64-hex-characters   # AES-256 key for payout details and OAuth tokens

# administrator (matched against the verified Google identity, never against user input)
ADMIN_EMAIL=syrixcompany@gmail.com

# Google OAuth 2.0 (Google Cloud Console: OAuth consent screen, People API enabled, redirect URI added)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://vcf.example.com/api/auth/google/callback

# transactional email (optional until a provider is chosen)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=SYRIX VCF <no-reply@vcf.example.com>

# ads (off by default). Only public pages and the dashboard overview show ads, and only after consent.
ADS_ENABLED=false
ADS_CLIENT_ID=                              # your ad provider's publisher id, required when ADS_ENABLED=true

# reverse proxy: set a real domain whose DNS points to this server to get automatic HTTPS
DOMAIN=vcf.example.com
