# SYRIX VCF — public entry point. Caddy obtains and renews the HTTPS certificate for {$DOMAIN} automatically.
# The app sets the Content-Security-Policy and the other page headers itself; Caddy adds transport-level ones.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	request_body {
		max_size 6MB
	}
	reverse_proxy app:3000 {
		header_up X-Forwarded-Proto {scheme}
	}
	log {
		output stdout
		format json
	}
}
