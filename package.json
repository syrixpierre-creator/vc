{
  "name": "queen-akuma",
  "version": "3.6.3",
  "description": "QUEEN AKUMA \u2014 advanced multi-device WhatsApp bot (deploy-ready, command/ pack)",
  "main": "manager.js",
  "directories": {
    "lib": "lib",
    "data": "data",
    "plugins": "command"
  },
  "scripts": {
    "start": "node manager.js",
    "start:single": "node index.js",
    "bot:add": "node manager.js add",
    "bot:list": "node manager.js list",
    "bot:remove": "node manager.js remove",
    "dev": "nodemon index.js",
    "check": "node --check index.js && node --check settings.js && node --check config.js && node test.js",
    "lint": "node test.js",
    "start:optimized": "node manager.js",
    "cleanup": "node cleanup.js",
    "reset-session": "node reset-session.js",
    "start:clean": "npm run cleanup && npm run start:optimized",
    "start:fresh": "npm run reset-session && npm start",
    "install:panel": "npm install --legacy-peer-deps",
    "install:force": "npm install --force",
    "test": "node test.js",
    "start:prod": "node manager.js"
  },
  "keywords": [
    "whatsapp-bot",
    "baileys",
    "multi-device",
    "queen-akuma",
    "inconnu-boy-sensei"
  ],
  "license": "MIT",
  "author": "INCONNU BOY SENSEI",
